# Base URL of the canonical DAEMON Authoring API, including the /api/v1 prefix.
# Local acceptance stack:
#   DAEMON_API_BASE_URL=http://127.0.0.1:8000/api/v1
# Production (read-only unless you were given a production authoring token):
#   DAEMON_API_BASE_URL=https://daemon-5vo1.onrender.com/api/v1
DAEMON_API_BASE_URL=http://127.0.0.1:8000/api/v1

# Sanctum service token issued with:
#   php artisan autoria:token emitir --actor=<email> --dias=90
# Scopes: course:read, course:write. Never course:publish. NEVER COMMIT THIS.
DAEMON_MCP_TOKEN=<DAEMON_MCP_TOKEN>

# Optional. Request timeout in milliseconds (default 30000).
# DAEMON_MCP_TIMEOUT_MS=30000

# Optional. Set to "silent" to disable the structured stderr operation log.
# DAEMON_MCP_LOG=info
