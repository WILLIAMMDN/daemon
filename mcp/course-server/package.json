{
  "name": "@daemon/course-mcp",
  "version": "1.0.0",
  "private": true,
  "description": "DAEMON Course MCP — canonical course authoring over the DAEMON Authoring API.",
  "license": "MIT",
  "type": "module",
  "engines": { "node": ">=20" },
  "bin": { "daemon-course-mcp": "dist/index.js" },
  "main": "dist/index.js",
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
